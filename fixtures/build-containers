#!/bin/sh
set -eu

destination="$1"
mkdir -p "$destination"

python3 -I - "$destination" <<'PYTHON'
import gzip
import io
import random
import sys
import tarfile
import zipfile

destination = sys.argv[1]
generator = random.Random("debar-clamav-harness-containers-1")
KIB = 1024
GENERIC = bytes.fromhex("b41a8bd6cd21b40fba5c00cd21b415cd21c3")
EICAR = b"X5O!P%@AP[4\\PZX54(P^)7CC)7}$EICAR-STANDARD-ANTIVIRUS-TEST-FILE!$H+H*"
FIXED_TIME = (1980, 1, 1, 0, 0, 0)


def binary(length):
    return bytes(0 if index % 8 == 0 else generator.getrandbits(8) for index in range(length))


def write(name, content):
    with open(f"{destination}/{name}", "wb") as file:
        file.write(content)


def stored_zip(entries):
    archive_bytes = io.BytesIO()
    with zipfile.ZipFile(archive_bytes, "w") as archive:
        for name, content in entries:
            entry = zipfile.ZipInfo(name, date_time=FIXED_TIME)
            entry.compress_type = zipfile.ZIP_STORED
            entry.external_attr = 0o644 << 16
            archive.writestr(entry, content)
    return archive_bytes.getvalue()


def tar_of(name, content):
    archive_bytes = io.BytesIO()
    with tarfile.open(fileobj=archive_bytes, mode="w", format=tarfile.GNU_FORMAT) as archive:
        member = tarfile.TarInfo(name)
        member.size = len(content)
        member.mtime = 0
        archive.addfile(member, io.BytesIO(content))
    return archive_bytes.getvalue()


prefix = binary(200)
write("container-zip-eicar.zip", stored_zip([("eicar.com", EICAR), ("clean.txt", b"A clean entry.\n")]))
write("container-gzip-eicar.gz", gzip.compress(EICAR, mtime=0))
write("container-tar-eicar.tar", tar_of("eicar.com", EICAR))
write("container-zip-in-binary.bin", prefix + stored_zip([("eicar.com", EICAR)]) + binary(100))
write("container-pe-generic.exe", b"MZ" + bytes(58) + b"\x40\x00\x00\x00" + b"PE\x00\x00" + binary(KIB) + GENERIC)
write("container-elf-generic", b"\x7fELF\x02\x01\x01" + bytes(9) + binary(KIB) + GENERIC)
write("container-pdf-eicar.pdf",
      b"%PDF-1.4\n1 0 obj\n<< /Length 68 >>\nstream\n" + EICAR + b"\nendstream\nendobj\ntrailer\n<< >>\n%%EOF\n")
write("container-ole2-generic.doc", b"\xd0\xcf\x11\xe0\xa1\xb1\x1a\xe1" + binary(4 * KIB) + GENERIC)
PYTHON
